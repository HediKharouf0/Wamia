{
  "name": "wamia",
  "version": "1.0.0",
  "description": "Wamia: a liquidity backstop for Pendle PT markets on 1inch Aqua and SwapVM",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p app/tsconfig.json",
    "test": "tsx src/pricing/fairValue.test.ts && tsx src/pricing/units.test.ts && tsx src/strategies/sizing.test.ts && tsx src/strategies/searcher.test.ts",
    "sdk:vectors": "tsx src/aqua/exportSdkVectors.ts",
    "demo:local": "tsx src/aqua/localDemo.ts",
    "scenario:maker": "tsx src/replay/compareMaker.ts",
    "scenario:collapse": "tsx src/replay/collapseScenarios.ts",
    "app:data": "tsx src/app/buildReplayData.ts",
    "app": "vite --config app/vite.config.ts",
    "app:build": "vite build --config app/vite.config.ts",
    "app:hosted": "WAMIA_HOSTED=1 vite build --config app/vite.config.ts",
    "app:server": "tsx src/app/server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HediKharouf0/p1nch.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/HediKharouf0/p1nch/issues"
  },
  "homepage": "https://github.com/HediKharouf0/p1nch#readme",
  "dependencies": {
    "@1inch/aqua-sdk": "0.3.4",
    "@1inch/swap-vm-sdk": "0.4.4",
    "dotenv": "^18.0.4",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "type": "module"
}
